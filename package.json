{
  "name": "pixel-fishing",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "description": "8-bit lure fishing mod for Claude Code (pixel-fishing) and its reference asset pack",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:icon": "node tools/build-icon.cjs",
    "build:demo": "tsx --tsconfig tools/tsconfig.demo.json tools/build-demo.mts",
    "gen:sprites": "node tools/gen-sprites.cjs",
    "validate": "claude plugin validate .",
    "test": "claude plugin test .",
    "preview": "node fishing-mod-assets-v1/tools/serve-preview.cjs",
    "validate:assets": "node fishing-mod-assets-v1/tools/validate-assets.cjs",
    "build:assets": "node fishing-mod-assets-v1/tools/build-assets.cjs",
    "build:preview": "node fishing-mod-assets-v1/tools/build-preview.cjs"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "tsx": "^4.23.15"
  }
}
